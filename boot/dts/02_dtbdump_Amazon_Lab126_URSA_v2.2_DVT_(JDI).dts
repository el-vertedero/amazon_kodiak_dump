			qcom,vdd-voltage-level = <0x2d0370 0x2d0370>;
			qcom,vdd-current-level = "\0\0#(\0\f5";
			vdd-io-supply = <0x11>;
			qcom,vdd-io-voltage-level = <0x2d0370 0x2d0370>;
			qcom,vdd-io-current-level = <0x06 0x55f0>;
