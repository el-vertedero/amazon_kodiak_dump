			phandle = <0x6c>;

			qcom,cpu-modes {
				compatible = "qcom,cpu-modes";

				qcom,cpu-mode@0 {
					qcom,mode = "wfi";
					qcom,latency-us = <0x01>;
					qcom,ss-power = <0x2cb>;
					qcom,energy-overhead = <0x4524>;
					qcom,time-overhead = <0x02>;
				};

				qcom,cpu-mode@1 {
					qcom,mode = "retention";
					qcom,latency-us = <0x23>;
					qcom,ss-power = <0x21e>;
					qcom,energy-overhead = <0x8868>;
					qcom,time-overhead = <0x28>;
				};

				qcom,cpu-mode@2 {
					qcom,mode = "standalone_pc";
					qcom,latency-us = <0x12c>;
					qcom,ss-power = <0x1dc>;
					qcom,energy-overhead = <0x37014>;
					qcom,time-overhead = <0x15e>;
				};

				qcom,cpu-mode@3 {
					qcom,mode = "pc";
					qcom,latency-us = <0x1f4>;
					qcom,ss-power = <0x190>;
					qcom,energy-overhead = <0x445c0>;
					qcom,time-overhead = <0x1f4>;
				};
			};

			qcom,system-modes {
				compatible = "qcom,system-modes";

				qcom,system-mode@0 {
					qcom,l2 = "l2_cache_gdhs";
					qcom,latency-us = <0x1f4>;
					qcom,ss-power = <0xa3>;
					qcom,energy-overhead = <0x8d0c8>;
					qcom,time-overhead = <0x3e8>;
					qcom,min-cpu-mode = "standalone_pc";
					qcom,sync-cpus;
				};

				qcom,system-mode@1 {
					qcom,l2 = "l2_cache_pc";
					qcom,latency-us = <0x7530>;
					qcom,ss-power = <0x53>;
					qcom,energy-overhead = <0x22b474>;
					qcom,time-overhead = <0x19cd>;
					qcom,min-cpu-mode = "pc";
					qcom,sync-cpus;
					qcom,send-rpm-sleep-set;
				};
			};
		};

