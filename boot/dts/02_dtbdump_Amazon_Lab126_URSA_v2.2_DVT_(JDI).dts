			lab126,camera@6a {
				compatible = "lab126,ov680";
				reg = <0x6a>;
				qcom,slave-id = <0x6a 0x6000 0x1ea0>;
				qcom,csiphy-sd-index = <0x02>;
				qcom,csid-sd-index = <0x02>;
