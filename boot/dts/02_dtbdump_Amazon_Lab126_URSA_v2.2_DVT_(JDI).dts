						interrupts = <0x00 0x12 0x00 0x00 0x12 0x01 0x00 0x12 0x02 0x00 0x12 0x03 0x00 0x12 0x04>;
						interrupt-names = "batt-pres\0bat-temp-ok\0bat-fet-on\0vcp-on\0psi";
						regulator-name = "batfet";
