/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "Amazon/Lab126 URSA v2.2 DVT (JDI)";
	compatible = "lab126,ursa\0qcom,msm8974";
	interrupt-parent = <0x01>;
	qcom,msm-id = <0x7e 0xc53 0x20002>;

	chosen {
	};

	aliases {
		spi0 = "/soc/spi@f9923000";
		spi7 = "/soc/spi@f9966000";
		sdhc1 = "/soc/sdhci@f9824900";
		sdhc2 = "/soc/sdhci@f98a4900";
		sdhc3 = "/soc/sdhci@f9864900";
		sdhc4 = "/soc/sdhci@f98e4900";
		smd1 = "/soc/qcom,smdtty/qcom,smdtty-apps-fm";
		smd2 = "/soc/qcom,smdtty/smdtty-apps-riva-bt-acl";
		smd3 = "/soc/qcom,smdtty/qcom,smdtty-apps-riva-bt-cmd";
		smd4 = "/soc/qcom,smdtty/qcom,smdtty-mbalbridge";
		smd5 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-cmd";
		smd6 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-data";
		smd7 = "/soc/qcom,smdtty/qcom,smdtty-data1";
		smd11 = "/soc/qcom,smdtty/qcom,smdtty-data11";
		smd21 = "/soc/qcom,smdtty/qcom,smdtty-data21";
		smd27 = "/soc/qcom,smdtty/smdtty-gpsnmea";
		smd36 = "/soc/qcom,smdtty/smdtty-loopback";
		serial0 = "/soc/serial@f991e000";
	};

	memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		device_type = "memory";
		reg = <0x00 0x00>;

		secure_region {
			linux,contiguous-region;
			linux,reserve-region;
			reg = <0x00 0x9d00000>;
			label = "secure_mem";
			linux,phandle = <0x1b>;
			phandle = <0x1b>;
		};

		adsp_region {
			linux,contiguous-region;
			reg = <0x00 0x3f00000>;
			label = "adsp_mem";
			linux,phandle = <0x1c>;
			phandle = <0x1c>;
		};

		qsecom_region {
			linux,contiguous-region;
			reg = <0x00 0x1100000>;
			label = "qseecom_mem";
			linux,phandle = <0x1d>;
			phandle = <0x1d>;
		};
	};

	cpus {
		#size-cells = <0x00>;
		#address-cells = <0x01>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,krait";
			reg = <0x00>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "qcom,krait";
			reg = <0x01>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "qcom,krait";
			reg = <0x02>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "qcom,krait";
			reg = <0x03>;
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		qcom,msm-cam@fd8C0000 {
			compatible = "qcom,msm-cam";
			reg = <0xfd8c0000 0x10000>;
			reg-names = "msm-cam";
		};

		qcom,csiphy@fda0ac00 {
			cell-index = <0x00>;
			compatible = "qcom,csiphy";
			reg = <0xfda0ac00 0x200 0xfda00030 0x04>;
			reg-names = "csiphy\0csiphy_clk_mux";
			interrupts = <0x00 0x4e 0x00>;
			interrupt-names = "csiphy";
		};

		qcom,csiphy@fda0b000 {
			cell-index = <0x01>;
			compatible = "qcom,csiphy";
			reg = <0xfda0b000 0x200 0xfda00038 0x04>;
			reg-names = "csiphy\0csiphy_clk_mux";
			interrupts = <0x00 0x4f 0x00>;
			interrupt-names = "csiphy";
		};

		qcom,csiphy@fda0b400 {
			cell-index = <0x02>;
			compatible = "qcom,csiphy";
			reg = <0xfda0b400 0x200 0xfda00040 0x04>;
			reg-names = "csiphy\0csiphy_clk_mux";
			interrupts = <0x00 0x50 0x00>;
			interrupt-names = "csiphy";
		};

		qcom,csid@fda08000 {
			cell-index = <0x00>;
			compatible = "qcom,csid";
			reg = <0xfda08000 0x100>;
			reg-names = "csid";
			interrupts = <0x00 0x33 0x00>;
			interrupt-names = "csid";
			qcom,csi-vdd-voltage = <0x1b7740>;
			qcom,mipi-csi-vdd-supply = <0x02>;
		};

		qcom,csid@fda08400 {
			cell-index = <0x01>;
			compatible = "qcom,csid";
			reg = <0xfda08400 0x100>;
			reg-names = "csid";
			interrupts = <0x00 0x34 0x00>;
			interrupt-names = "csid";
			qcom,csi-vdd-voltage = <0x1b7740>;
			qcom,mipi-csi-vdd-supply = <0x02>;
		};

		qcom,csid@fda08800 {
			cell-index = <0x02>;
			compatible = "qcom,csid";
			reg = <0xfda08800 0x100>;
			reg-names = "csid";
			interrupts = <0x00 0x35 0x00>;
			interrupt-names = "csid";
			qcom,csi-vdd-voltage = <0x1b7740>;
			qcom,mipi-csi-vdd-supply = <0x02>;
		};

		qcom,csid@fda08C00 {
			cell-index = <0x03>;
			compatible = "qcom,csid";
			reg = <0xfda08c00 0x100>;
			reg-names = "csid";
			interrupts = <0x00 0x36 0x00>;
			interrupt-names = "csid";
			qcom,csi-vdd-voltage = <0x1b7740>;
			qcom,mipi-csi-vdd-supply = <0x02>;
		};

		qcom,ispif@fda0A000 {
			cell-index = <0x00>;
			compatible = "qcom,ispif-v3.0\0qcom,ispif";
			reg = <0xfda0a000 0x500 0xfda00020 0x10>;
			reg-names = "ispif\0csi_clk_mux";
			interrupts = <0x00 0x37 0x00>;
			interrupt-names = "ispif";
			qcom,num-isps = <0x02>;
		};

		qcom,vfe@fda10000 {
			cell-index = <0x00>;
			compatible = "qcom,vfe40";
			reg = <0xfda10000 0x1000 0xfda40000 0x200 0xfd4a8000 0x04>;
			reg-names = "vfe\0vfe_vbif\0tcsr";
			interrupts = <0x00 0x39 0x00>;
			interrupt-names = "vfe";
			vdd-supply = <0x03>;
		};

		qcom,vfe@fda14000 {
			cell-index = <0x01>;
			compatible = "qcom,vfe40";
			reg = <0xfda14000 0x1000 0xfda40000 0x200 0xfd4a8000 0x04>;
			reg-names = "vfe\0vfe_vbif\0tcsr";
			interrupts = <0x00 0x3a 0x00>;
			interrupt-names = "vfe";
			vdd-supply = <0x03>;
		};

		qcom,jpeg@fda1c000 {
			cell-index = <0x00>;
			compatible = "qcom,jpeg";
			reg = <0xfda1c000 0x400>;
			reg-names = "jpeg";
			interrupts = <0x00 0x3b 0x00>;
			interrupt-names = "jpeg";
			vdd-supply = <0x04>;
		};

		qcom,jpeg@fda20000 {
			cell-index = <0x01>;
			compatible = "qcom,jpeg";
			reg = <0xfda20000 0x400>;
			reg-names = "jpeg";
			interrupts = <0x00 0x3c 0x00>;
			interrupt-names = "jpeg";
			vdd-supply = <0x04>;
		};

		qcom,jpeg@fda24000 {
			cell-index = <0x02>;
			compatible = "qcom,jpeg";
			reg = <0xfda24000 0x400>;
			reg-names = "jpeg";
			interrupts = <0x00 0x3d 0x00>;
			interrupt-names = "jpeg";
			vdd-supply = <0x04>;
		};

		qcom,irqrouter@fda00000 {
			cell-index = <0x00>;
			compatible = "qcom,irqrouter";
			reg = <0xfda00000 0x100>;
			reg-names = "irqrouter";
		};

		qcom,cpp@fda04000 {
			cell-index = <0x00>;
			compatible = "qcom,cpp";
			reg = <0xfda04000 0x100 0xfda40000 0x200 0xfda18000 0x18>;
			reg-names = "cpp\0cpp_vbif\0cpp_hw";
			interrupts = <0x00 0x31 0x00>;
			interrupt-names = "cpp";
			vdd-supply = <0x03>;
			qcom,clock-names = "camss_top_ahb_clk\0vfe_clk_src\0camss_vfe_vfe_clk\0iface_clk\0cpp_core_clk\0cpp_iface_clk\0cpp_bus_clk\0micro_iface_clk";
			qcom,clock-rates = <0x00 0xfe50fb0 0x00 0x00 0xfe50fb0 0x00 0x00 0x00>;
		};

		qcom,cci@fda0C000 {
			cell-index = <0x00>;
			compatible = "qcom,cci";
			reg = <0xfda0c000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg-names = "cci";
			interrupts = <0x00 0x32 0x00>;
			interrupt-names = "cci";
			qcom,clock-names = "camss_top_ahb_clk\0cci_src_clk\0cci_ahb_clk\0cci_clk";
			qcom,clock-rates = <0x00 0x124f800 0x00 0x00>;
			gpios = <0x05 0x13 0x00 0x05 0x14 0x00 0x05 0x15 0x00 0x05 0x16 0x00>;
			qcom,gpio-tbl-num = <0x00 0x01 0x02 0x03>;
			qcom,gpio-tbl-flags = <0x01 0x01 0x01 0x01>;
			qcom,gpio-tbl-label = "CCI_I2C_DATA0\0CCI_I2C_CLK0\0CCI_I2C_DATA1\0CCI_I2C_CLK1";
			qcom,hw-scl-stretch-en = <0x01>;

			qcom,cci-master0 {
				status = "ok";
				qcom,hw-thigh = <0x0f>;
				qcom,hw-tlow = <0x1c>;
				qcom,hw-tsu-sto = <0x06>;
				qcom,hw-tsu-sta = <0x07>;
				qcom,hw-thd-dat = <0x0d>;
				qcom,hw-thd-sta = <0x0b>;
				qcom,hw-tbuf = <0x19>;
				qcom,hw-scl-stretch-en = <0x01>;
				qcom,hw-trdhld = <0x06>;
				qcom,hw-tsp = <0x03>;
			};

			qcom,cci-master1 {
				status = "ok";
				qcom,hw-thigh = <0x0f>;
				qcom,hw-tlow = <0x1c>;
				qcom,hw-tsu-sto = <0x06>;
				qcom,hw-tsu-sta = <0x07>;
				qcom,hw-thd-dat = <0x0d>;
				qcom,hw-thd-sta = <0x0b>;
				qcom,hw-tbuf = <0x19>;
				qcom,hw-scl-stretch-en = <0x01>;
				qcom,hw-trdhld = <0x06>;
				qcom,hw-tsp = <0x03>;
			};

			qcom,camera@6e {
				qcom,vdd-cx-supply = <0x06>;
				qcom,vdd-cx-name = "qcom,vdd-cx";
			};

			qcom,camera@20 {
				qcom,vdd-cx-supply = <0x06>;
				qcom,vdd-cx-name = "qcom,vdd-cx";
				compatible = "qcom,imx135";
				reg = <0x20>;
				qcom,slave-id = <0x20 0x16 0x135>;
				qcom,csiphy-sd-index = <0x00>;
				qcom,csid-sd-index = <0x00>;
				qcom,mount-angle = <0x5a>;
				qcom,sensor-name = "imx135";
				qcom,led-flash-src = <0x07>;
				qcom,actuator-src = <0x08>;
				qcom,eeprom-src = <0x09>;
				cam_vdig-supply = <0x0a>;
				cam_vana-supply = <0x0b>;
				qcom,cam-vreg-name = "cam_vdig\0cam_vana";
				qcom,cam-vreg-type = <0x01 0x00>;
				qcom,cam-vreg-min-voltage = <0x00 0x2ab980>;
				qcom,cam-vreg-max-voltage = <0x00 0x2b7cd0>;
				qcom,cam-vreg-op-mode = <0x00 0x14c08>;
				qcom,gpio-no-mux = <0x00>;
				gpios = <0x05 0x0f 0x00 0x05 0x59 0x00 0x05 0x11 0x00>;
				qcom,gpio-reset = <0x01>;
				qcom,gpio-req-tbl-num = <0x00 0x01 0x02>;
				qcom,gpio-req-tbl-flags = <0x01 0x00 0x01>;
				qcom,gpio-req-tbl-label = "CAM_MCLK0_MSM\0CAM_RFC_PWDN_N\0CAM_MCLK2_MSM";
				qcom,gpio-set-tbl-num = <0x01 0x01>;
				qcom,gpio-set-tbl-flags = <0x00 0x02>;
				qcom,gpio-set-tbl-delay = <0x3e8 0x7530>;
				qcom,csi-lane-assign = <0x4230>;
				qcom,csi-lane-mask = <0x1f>;
				qcom,sensor-position = <0x00>;
				qcom,sensor-mode = <0x00>;
				qcom,sensor-type = <0x00>;
				qcom,cci-master = <0x00>;
				status = "ok";
			};

			qcom,camera@6c {
				qcom,vdd-cx-supply = <0x06>;
				qcom,vdd-cx-name = "qcom,vdd-cx";
				compatible = "qcom,imx132";
				reg = <0x6c>;
				qcom,slave-id = <0x6c 0x00 0x132>;
				qcom,csiphy-sd-index = <0x01>;
				qcom,csid-sd-index = <0x00>;
				qcom,mount-angle = <0x10e>;
				qcom,sensor-name = "imx132";
				cam_vdig-supply = <0x0a>;
				cam_vana-supply = <0x0b>;
				cam_vio-supply = <0x0c>;
				qcom,cam-vreg-name = "cam_vdig\0cam_vana\0cam_vio";
				qcom,cam-vreg-type = <0x01 0x00 0x00>;
				qcom,cam-vreg-min-voltage = <0x00 0x2ab980 0x12b128>;
				qcom,cam-vreg-max-voltage = <0x00 0x2ab980 0x12b128>;
				qcom,cam-vreg-op-mode = <0x00 0x14c08 0x14c08>;
				qcom,gpio-no-mux = <0x00>;
				gpios = <0x05 0x0f 0x00 0x05 0x1f 0x00>;
				qcom,gpio-reset = <0x01>;
				qcom,gpio-req-tbl-num = <0x00 0x01>;
				qcom,gpio-req-tbl-flags = <0x01 0x00>;
				qcom,gpio-req-tbl-label = "CAM_MCLK0_MSM\0CAM_FFC_PWDN_N";
				qcom,gpio-set-tbl-num = <0x01 0x01>;
				qcom,gpio-set-tbl-flags = <0x00 0x02>;
				qcom,gpio-set-tbl-delay = <0x3e8 0x7530>;
				qcom,csi-lane-assign = <0x4320>;
				qcom,csi-lane-mask = <0x07>;
				qcom,sensor-position = <0x01>;
				qcom,sensor-mode = <0x01>;
				qcom,cci-master = <0x00>;
				status = "ok";
			};

			qcom,camera@90 {
				qcom,vdd-cx-supply = <0x06>;
				qcom,vdd-cx-name = "qcom,vdd-cx";
			};

			qcom,eeprom@a0 {
				cell-index = <0x00>;
				reg = <0xa0 0x00>;
				qcom,eeprom-name = "holly";
				compatible = "qcom,eeprom";
				qcom,slave-addr = <0xa0>;
				qcom,cci-master = <0x00>;
				qcom,num-blocks = <0x04>;
				qcom,page0 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll0 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem0 = <0x02 0x21 0x02 0x00 0x01 0x00>;
				qcom,page1 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll1 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem1 = <0x08 0x100 0x02 0x00 0x01 0x00>;
				qcom,page2 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll2 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem2 = <0x12 0x1000 0x02 0x00 0x01 0x00>;
				qcom,page3 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll3 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem3 = <0xc30 0x1015 0x02 0x00 0x01 0x00>;
				cam_vdig-supply = <0x0a>;
				qcom,cam-vreg-name = "cam_vdig";
				qcom,cam-vreg-type = <0x01>;
				qcom,cam-vreg-min-voltage = <0x00>;
				qcom,cam-vreg-max-voltage = <0x00>;
				qcom,cam-vreg-op-mode = <0x00>;
				qcom,cam-power-seq-type = "sensor_vreg";
				qcom,cam-power-seq-val = "cam_vdig";
				qcom,cam-power-seq-cfg-val = <0x01>;
				qcom,cam-power-seq-delay = <0x01>;
				linux,phandle = <0x09>;
				phandle = <0x09>;
			};

			qcom,actuator@1C {
				cell-index = <0x01>;
				reg = <0x1c>;
				compatible = "qcom,actuator";
				qcom,cci-master = <0x00>;
				linux,phandle = <0x08>;
				phandle = <0x08>;
