				qcom,vdd-cx-supply = <0x06>;
				qcom,vdd-cx-name = "qcom,vdd-cx";
				cam_vana-supply = <0x0d>;
				cam_vdig-supply = <0x0e>;
				cam_vio-supply = <0x0a>;
				qcom,cam-vreg-name = "cam_vdig\0cam_vio\0cam_vana";
				qcom,cam-vreg-type = <0x01 0x01 0x00>;
				qcom,cam-vreg-min-voltage = <0x00 0x00 0x2ab980>;
				qcom,cam-vreg-max-voltage = <0x00 0x00 0x2ab980>;
				qcom,cam-vreg-op-mode = <0x00 0x00 0x13880>;
				qcom,gpio-no-mux = <0x00>;
				gpios = <0x05 0x10 0x00 0x05 0x1a 0x00 0x05 0x17 0x00 0x05 0x38 0x00 0x05 0x12 0x00>;
				interrupt-parent = <0x05>;
				interrupts = <0x12 0x00>;
				lab126,gpio-cmd-rdy-irq-num = <0x04>;
				qcom,gpio-reset = <0x01>;
				qcom,gpio-standby = <0x02>;
				qcom,gpio-req-tbl-num = <0x00 0x01 0x02 0x03>;
				qcom,gpio-req-tbl-flags = <0x01 0x00 0x00 0x00>;
				qcom,gpio-req-tbl-label = "CAM_4CC_MCLK1\0CAM_4CC_XPWDN\0CAM_4CC_RST_N\0CAM_4CC_LED_QUAD";
				qcom,gpio-set-tbl-num = <0x01 0x01 0x02 0x02>;
				qcom,gpio-set-tbl-flags = <0x00 0x02 0x00 0x02>;
				qcom,gpio-set-tbl-delay = <0x00 0x00 0x3e8 0xfa0>;
				qcom,csi-lane-assign = <0x4320>;
				qcom,csi-lane-mask = <0x07>;
				qcom,sensor-position = <0x02>;
