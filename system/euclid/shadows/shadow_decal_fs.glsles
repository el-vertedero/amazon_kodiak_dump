uniform sampler2D texture0;
uniform sampler2D texture1;
uniform sampler2D texture2;
uniform sampler2D texture3;

uniform mediump int decalCount;
uniform mediump float intensity;

uniform mediump vec2 uv_scale[4];
varying vec2 v_positions[4];

void main()
{
    float factor = 1.0f;

    if( decalCount > 0 )
        factor *= (1.0 - texture2D(texture0, uv_scale[0] * v_positions[0]).r * intensity);
    if( decalCount > 1 )
        factor *= (1.0 - texture2D(texture1, uv_scale[1] * v_positions[1]).r * intensity);
    if( decalCount > 2 )
        factor *= (1.0 - texture2D(texture2, uv_scale[2] * v_positions[2]).r * intensity);
    if( decalCount > 3 )
        factor *= (1.0 - texture2D(texture3, uv_scale[3] * v_positions[3]).r * intensity);

    factor = max( factor, (1.0 - intensity) );
    gl_FragColor.a = 1.0f;
    gl_FragColor.rgb = vec3(factor);
}
