vertex_program shadow_vs glsles
{
    source shadow_vs.glsles
    profiles glsles
    default_params
    {
        param_named_auto wvp worldviewproj_matrix
    }
}

vertex_program shadow_textured_vs glsles
{
    source shadow_textured_vs.glsles
    profiles glsles
    default_params
    {
        param_named_auto wvp worldviewproj_matrix
    }
}

fragment_program shadow_drop_fs glsles
{
    source shadow_drop_fs.glsles
    profiles glsles
    default_params
    {
        param_named intensity float 0.8
        param_named texture int 0
    }
}

fragment_program shadow_blit_fs glsles
{
    source shadow_blit_fs.glsles
    profiles glsles
    default_params
    {
        param_named texture int 0
    }
}

fragment_program shadow_drop_alpha_fs glsles
{
    source shadow_drop_alpha_fs.glsles
    profiles glsles
    default_params
    {
        param_named intensity float 0.8
        param_named texture int 0
    }
}

vertex_program shadow_decal_vs glsles
{
    source shadow_decal_vs.glsles
    profiles glsles
    default_params
    {
        param_named_auto worldViewProjMat worldviewproj_matrix
    }
}

fragment_program shadow_decal_fs glsles
{
    source shadow_decal_fs.glsles
    profiles glsles
    default_params
    {
        param_named intensity float 1.0
        param_named texture0 int 0
        param_named texture1 int 1
        param_named texture2 int 2
        param_named texture3 int 3
    }
}

