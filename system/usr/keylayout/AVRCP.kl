# Key layout used for Bluetooth AVRCP support.

# ACOS_MOD_BEGIN {bt_fwk_bug_fix}
key 200   MEDIA_PLAY          WAKE DISABLE_KEY_REPEAT
key 201   MEDIA_PAUSE         WAKE DISABLE_KEY_REPEAT
key 166   MEDIA_STOP          WAKE DISABLE_KEY_REPEAT
key 163   MEDIA_NEXT          WAKE DISABLE_KEY_REPEAT
key 165   MEDIA_PREVIOUS      WAKE DISABLE_KEY_REPEAT
key 168   MEDIA_REWIND        WAKE DISABLE_KEY_REPEAT
key 208   MEDIA_FAST_FORWARD  WAKE DISABLE_KEY_REPEAT
# ACOS_MOD_END {bt_fwk_bug_fix}
